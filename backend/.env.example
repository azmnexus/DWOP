# Application
PROJECT_NAME="DWOP Platform API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Security
SECRET_KEY="replace-this-with-a-secure-random-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database (PostgreSQL)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="password"
POSTGRES_DB="dwop_db"
DATABASE_URL="postgresql+psycopg2://postgres:password@localhost:5432/dwop_db"

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# Integrations
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
TRELLO_API_KEY=""
TRELLO_API_SECRET=""
